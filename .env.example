# Copy this file to .env and fill in the values.

# Anthropic API key (https://console.anthropic.com → Settings → API Keys)
ANTHROPIC_API_KEY=

# MongoDB where every question and answer is saved for the admin panel.
# Use the same database as the website backend (backend/.env MONGO_URI).
# Leave empty to not save conversations.
MONGO_URI=mongodb://127.0.0.1:27017/techzar

# Port this AI server listens on
PORT=4000

# Website addresses allowed to call this server, comma-separated
# (local dev site, plus the live site once deployed)
ALLOWED_ORIGINS=http://localhost:3000,https://www.techzarinfo.com

# Set to true only when running behind a reverse proxy (nginx, load balancer),
# so the rate limit uses the real visitor IP from X-Forwarded-For
TRUST_PROXY=false

# Questions each visitor may ask per 24 hours (no login needed). After the last one they
# must wait 24 hours. Counted per browser (anonymous visitor ID) and per IP address.
CHAT_DAILY_LIMIT=7
# Optional: a separate limit per IP address (defaults to CHAT_DAILY_LIMIT). Raise it if many
# people share one network (an office) and get blocked together.
# CHAT_IP_DAILY_LIMIT=7
